# Clave de la API de OpenAI (platform.openai.com > API keys). NUNCA la subas a git.
OPENAI_API_KEY=sk-...
# Modelo de imagen (opcional). Ej: gpt-image-2, gpt-image-1.5, gpt-image-1-mini
PINCEL_MODELO=gpt-image-2
# Carpeta donde se guardan las imágenes (opcional)
PINCEL_CARPETA=./imagenes
# Cuántas imágenes se generan a la vez (opcional)
PINCEL_PARALELO=4
