# Contraseña para entrar a la app
PINCEL_CLAVE=una-contraseña-segura
# Clave secreta del conector (larga y aleatoria). Forma parte de la URL del conector: NO la compartas.
PINCEL_TOKEN=cambia-esto-por-algo-largo-y-aleatorio
# URL pública donde queda publicada la app (sin / al final). En Vercel es opcional: se detecta sola.
PINCEL_URL_PUBLICA=https://pincel-ia.vercel.app

# --- Con Vercel (o cualquier hosting sin disco): base de datos Postgres (Neon). ---
# Vercel la agrega solo al conectar Neon desde Storage; en otros sitios, pégala aquí.
# DATABASE_URL=postgresql://usuario:clave@host/base?sslmode=require

# --- Con disco (local, Render, Docker): se usa SQLite y se guardan los archivos aquí. ---
PINCEL_DATOS=./datos
